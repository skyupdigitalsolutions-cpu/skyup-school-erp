# ==========================================================
# APPLICATION
# ==========================================================
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:5173

# ==========================================================
# DATABASE  (MongoDB Atlas — database-per-school tenancy)
# ==========================================================
# Cluster URI WITHOUT a database name in the path. The control-plane DB
# and every per-school DB live on this cluster and are selected by name.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
# Control-plane database holding the tenant (school) registry + platform admins
CONTROL_PLANE_DB=school_erp_control
# Prefix used when generating each school's database name (e.g. school_erp_<slug>)
TENANT_DB_PREFIX=school_erp_

# ==========================================================
# AUTH / JWT
# ==========================================================
JWT_ACCESS_SECRET=replace_with_long_random_string
JWT_REFRESH_SECRET=replace_with_different_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Cookie settings for the refresh token (HttpOnly)
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# ==========================================================
# RATE LIMITING
# ==========================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# ==========================================================
# CLOUDINARY (file storage)
# ==========================================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==========================================================
# EMAIL (Nodemailer SMTP)
# ==========================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="School ERP <no-reply@example.com>"

# ==========================================================
# NOTIFICATIONS (WhatsApp / SMS) — provider keys added per module
# ==========================================================
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
# Both required alongside the two above to actually send (see
# integrations/whatsapp/WhatsAppClient.js) — MSG91's WhatsApp send contract
# needs the sending business number and an APPROVED template name; nothing
# sends until all four of these are set.
WHATSAPP_SENDER_NUMBER=
WHATSAPP_TEMPLATE_NAME=
SMS_API_URL=
SMS_API_KEY=

# ==========================================================
# LOGGING
# ==========================================================
LOG_LEVEL=info
